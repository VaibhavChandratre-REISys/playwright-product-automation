# Copy this file to .env.auto (or .env.qa, .env.uat, etc.) and fill in real values.
# Never commit real credential files — only .env.example is committed.

ENV=auto
BROWSER=chromium
HEADLESS=false
SLOW_MO=0
DEFAULT_TIMEOUT_MS=30000

GRANTOR_BASE_URL=https://your-env.sandbox.my.salesforce.com
GRANTOR_INTERNAL_URL=https://your-env.sandbox.my.salesforce.com
GRANTEE_PORTAL_URL=https://your-env.sandbox.my.site.com/recipient

ADMIN_USERNAME=
ADMIN_PASSWORD=
PM_USERNAME=
PM_PASSWORD=
EXE_USERNAME=
EXE_PASSWORD=
FO_USERNAME=
FO_PASSWORD=
PO_USERNAME=
PO_PASSWORD=
FD_USERNAME=
FD_PASSWORD=
PM1_USERNAME=
PM1_PASSWORD=
EXE1_USERNAME=
EXE1_PASSWORD=
FO1_USERNAME=
FO1_PASSWORD=
FD1_USERNAME=
FD1_PASSWORD=
GRANTEE_SC_USERNAME=
GRANTEE_SC_PASSWORD=
GRANTEE_LEA_USERNAME=
GRANTEE_LEA_PASSWORD=
GRANTEE_CE_USERNAME=
GRANTEE_CE_PASSWORD=
GRANTEE_VO_USERNAME=
GRANTEE_VO_PASSWORD=

# JWT Authentication (MFA-proof login) — set SF_AUTH_MODE=password to use legacy login
SF_AUTH_MODE=jwt
SF_CONSUMER_KEY=
SF_PRIVATE_KEY_PATH=./certs/server.key
