PROJECT=govgrant_framework
ENV=AFSAUTO-GRANTOR
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT_MS=30000

GRANTOR_BASE_URL=https://your-afs-sandbox.sandbox.my.salesforce.com
GRANTOR_INTERNAL_URL=https://your-afs-sandbox.sandbox.my.salesforce.com
GRANTEE_PORTAL_URL=https://your-afs-sandbox.sandbox.my.site.com/recipient

# Required grantor roles
ADMIN_USERNAME=<admin-salesforce-username>
ADMIN_PASSWORD=<admin-salesforce-password>
PM_USERNAME=<pm-salesforce-username>
PM_PASSWORD=<pm-salesforce-password>
EXE_USERNAME=<exe-salesforce-username>
EXE_PASSWORD=<exe-salesforce-password>
FO_USERNAME=<fo-salesforce-username>
FO_PASSWORD=<fo-salesforce-password>

# Optional grantor roles
ADMIN1_USERNAME=<admin1-salesforce-username>
ADMIN1_PASSWORD=<admin1-salesforce-password>
PM1_USERNAME=<pm1-salesforce-username>
PM1_PASSWORD=<pm1-salesforce-password>
EXE1_USERNAME=<exe1-salesforce-username>
EXE1_PASSWORD=<exe1-salesforce-password>
FO1_USERNAME=<fo1-salesforce-username>
FO1_PASSWORD=<fo1-salesforce-password>
PO_USERNAME=<po-salesforce-username>
PO_PASSWORD=<po-salesforce-password>
PO1_USERNAME=<po1-salesforce-username>
PO1_PASSWORD=<po1-salesforce-password>
FD_USERNAME=<fd-salesforce-username>
FD_PASSWORD=<fd-salesforce-password>
FD1_USERNAME=<fd1-salesforce-username>
FD1_PASSWORD=<fd1-salesforce-password>
AUDITOR_USERNAME=<auditor-salesforce-username>
AUDITOR_PASSWORD=<auditor-salesforce-password>
SPI3_USERNAME=<spi3-salesforce-username>
SPI3_PASSWORD=<spi3-salesforce-password>
SPA_USERNAME=<spa-salesforce-username>
SPA_PASSWORD=<spa-salesforce-password>
SA_USERNAME=<sa-salesforce-username>
SA_PASSWORD=<sa-salesforce-password>
IND_USERNAME=<individual-salesforce-username>
IND_PASSWORD=<individual-salesforce-password>
SME_USERNAME=<sme-salesforce-username>
SME_PASSWORD=<sme-salesforce-password>
SPI4_USERNAME=<spi4-salesforce-username>
SPI4_PASSWORD=<spi4-salesforce-password>
SARAH_PM_USERNAME=<sarah-pm-salesforce-username>
SARAH_PM_PASSWORD=<sarah-pm-salesforce-password>

# Salesforce API authentication
SF_LOGIN_URL=https://your-afs-sandbox.sandbox.my.salesforce.com
SF_CLIENT_ID=<salesforce-oauth-client-id>
SF_CLIENT_SECRET=<salesforce-oauth-client-secret>
SF_API_USERNAME=<salesforce-api-username>
SF_API_PASSWORD=<salesforce-api-password>
SF_AUTH_MODE=jwt

# JWT authentication
SF_CONSUMER_KEY=<salesforce-connected-app-consumer-key>
SF_PRIVATE_KEY_PATH=<absolute-or-workspace-relative-private-key-path>

# Display names used by SavedValues
ADMIN_DisplayName=Automation ADMIN
ADMIN1_DisplayName=Automation ADMIN1
EXE_DisplayName=Automation EXE
FO_DisplayName=Automation FO
PO_DisplayName=Automation PO
FD_DisplayName=Automation FD
PM_DisplayName=Automation PM
PM1_DisplayName=Automation PM1
EXE1_DisplayName=Automation EXE1
FO1_DisplayName=Automation FO1
PO1_DisplayName=Automation PO1
FD1_DisplayName=Automation FD1
AUDITOR_DisplayName=Automation AUDITOR
SPI_DisplayName=Automation SPI
SPI3_DisplayName=Automation SPI3
SPA_DisplayName=Automation SPA
SPI4_DisplayName=Automation SPI4
IND_DisplayName=Automation IND
SME_DisplayName=Automation SME
